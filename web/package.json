{
  "name": "sdpoker-web",
  "private": true,
  "description": "Browser application for checking SDP files with SDPoker.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "examples": "node scripts/copy-examples.mjs",
    "predev": "npm run examples",
    "dev": "vite",
    "prebuild": "npm run examples",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run examples",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
